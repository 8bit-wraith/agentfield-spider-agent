# Lightpanda CDP server — multi-stage optimized build.
#
# We ship TWO paths in this Dockerfile, gated by BUILD_MODE:
#
#   binary  (default)
#     - fetches the upstream binary from
#       https://github.com/lightpanda-io/browser/releases (nightly)
#     - layers cleanly so docker can cache between builds
#     - jemalloc preloaded at runtime for ~15-30% memory wins on
#       browser workloads (lots of small allocs)
#     - slim runtime layer (~30 MB final)
#
#   source
#     - clones the lightpanda repo at the version we want
#     - builds with Zig + wild linker + jemalloc
#     - clang-style optimizer flags
#     - larger build layer (~600 MB toolchain) but the FINAL runtime
#       layer is still the same slim one
#
# Build:
#
#   # Default (fetch upstream binary):
#   docker build -f Dockerfile.lightpanda -t lightpanda-opt-ag:nightly .
#
#   # Source build (custom toolchain — wild + jemalloc):
#   docker build -f Dockerfile.lightpanda \
#     --build-arg BUILD_MODE=source \
#     --build-arg LIGHTPANDA_REF=main \
#     -t lightpanda-opt-ag:main-source .
#
# See scripts/build_browser.sh for the smart-build flow that checks
# upstream releases vs the private registry tag and builds only when
# upstream has moved.

ARG BUILD_MODE=binary
ARG LIGHTPANDA_REF=nightly
# Default arch — Linux x86_64. Build with `--platform linux/arm64` for
# arm64; the upstream release URL pattern handles both.
ARG LIGHTPANDA_ARCH=x86_64

# ─── Stage 1a: binary builder ────────────────────────────────────────
# Pulls the upstream binary into a fixed location. Cached aggressively
# — only re-runs when LIGHTPANDA_REF or LIGHTPANDA_ARCH change.
FROM debian:trixie-slim AS binary-fetcher
ARG LIGHTPANDA_REF
ARG LIGHTPANDA_ARCH

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN curl -fsSL \
        "https://github.com/lightpanda-io/browser/releases/download/${LIGHTPANDA_REF}/lightpanda-${LIGHTPANDA_ARCH}-linux" \
        -o /tmp/lightpanda && \
    chmod +x /tmp/lightpanda && \
    # Sanity check: binary runs and reports a version.
    /tmp/lightpanda --version || true

# ─── Stage 1b: source builder (opt-in) ───────────────────────────────
# Clones + compiles with the wild linker + jemalloc.
# Only used when BUILD_MODE=source. Kept in a separate stage so the
# binary path doesn't pay the toolchain cost.
FROM debian:trixie-slim AS source-builder
ARG LIGHTPANDA_REF

# Build deps: zig (via release tarball), clang+lld, wild linker, jemalloc,
# build essentials. We DON'T install zig from apt (very old); fetch the
# nightly tarball from ziglang.org.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates curl git build-essential \
        clang lld pkg-config xz-utils \
        libjemalloc-dev libjemalloc2 \
        && rm -rf /var/lib/apt/lists/*

# Wild linker. Built via cargo since prebuilt binaries aren't always
# published. Falls back to lld if wild build fails.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
        sh -s -- -y --default-toolchain stable --profile minimal && \
    . "$HOME/.cargo/env" && \
    cargo install --locked wild-linker || \
    echo "wild build failed; will fall back to lld"

# Zig (build dep). Tarball install for predictable version.
RUN ZIG_VERSION=0.13.0 && \
    curl -fsSL \
        "https://ziglang.org/download/${ZIG_VERSION}/zig-linux-x86_64-${ZIG_VERSION}.tar.xz" \
        | tar -xJ -C /opt && \
    ln -s /opt/zig-linux-x86_64-${ZIG_VERSION}/zig /usr/local/bin/zig && \
    zig version

# Clone + build lightpanda from source. CC/LD flags pull in:
#   -fno-omit-frame-pointer  cleaner perf profiles
#   -O2                      proven for Chromium-style workloads;
#                            -O3 sometimes regresses on browsers
#   -ljemalloc               link against jemalloc directly
#   -fuse-ld=wild (or lld)   faster link, smaller resulting binary
WORKDIR /build
RUN git clone --depth 1 --branch "${LIGHTPANDA_REF}" \
        https://github.com/lightpanda-io/browser.git . && \
    LDFLAGS="-fuse-ld=$(command -v wild >/dev/null && echo wild || echo lld) -ljemalloc" \
    CFLAGS="-O2 -fno-omit-frame-pointer" \
    PATH="$HOME/.cargo/bin:$PATH" \
    zig build -Drelease-fast=true || \
    (echo "Source build failed; aborting" && exit 1) && \
    cp zig-out/bin/lightpanda /tmp/lightpanda && \
    chmod +x /tmp/lightpanda

# ─── Stage 2: pick the binary ────────────────────────────────────────
# Selecting between binary-fetcher and source-builder via BUILD_MODE.
# We do this via a small staging step that knows which to copy from.
# Implemented as TWO concrete stages that the final FROM resolves; the
# unused stage is pruned by buildx.
FROM ${BUILD_MODE}-fetcher AS binary-pick
# Pre-existing /tmp/lightpanda from binary-fetcher.

FROM source-builder AS source-pick
# Pre-existing /tmp/lightpanda from source-builder.

# ─── Stage 3: slim runtime ───────────────────────────────────────────
# Final layer. Just the binary + jemalloc + CA certs. ~30 MB.
FROM debian:trixie-slim AS runtime

# Runtime deps: jemalloc (LD_PRELOAD'd), ca-certs (for HTTPS), tini
# (PID-1 signal handler so SIGTERM forwards correctly).
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        libjemalloc2 \
        tini \
        wget \
        && rm -rf /var/lib/apt/lists/* \
        && apt-get clean

# Copy the binary from whichever stage was selected by BUILD_MODE.
# Buildx prunes the unused stage automatically.
ARG BUILD_MODE
COPY --from=binary-pick /tmp/lightpanda /usr/local/bin/lightpanda

# Smoke check at build time. Fails the build if the binary is broken
# (better to catch here than at first runtime request).
RUN /usr/local/bin/lightpanda --version

# jemalloc as the malloc impl. Significant memory savings (~15-30%)
# on browser workloads where small alloc churn dominates. Path differs
# by arch — we use the symlink Debian provides.
ENV LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libjemalloc.so.2

# Configure the malloc — these are jemalloc tunings known to work well
# for browser-ish workloads. background_thread enables async purging.
ENV MALLOC_CONF=background_thread:true,metadata_thp:auto

# Serve config.
ENV LIGHTPANDA_HOST=0.0.0.0
ENV LIGHTPANDA_PORT=9222
ENV LIGHTPANDA_LOG_LEVEL=info
ENV LIGHTPANDA_LOG_FORMAT=pretty

EXPOSE 9222

# tini as PID 1 — forwards SIGTERM cleanly so container shutdown is
# fast (no 10s wait for SIGKILL). Lightpanda itself handles SIGTERM
# but the upstream image's ENTRYPOINT doesn't always.
ENTRYPOINT ["/usr/bin/tini", "--"]

CMD ["sh", "-c", "lightpanda serve --obey-robots \
    --host=${LIGHTPANDA_HOST} \
    --port=${LIGHTPANDA_PORT} \
    --log-level=${LIGHTPANDA_LOG_LEVEL} \
    --log-format=${LIGHTPANDA_LOG_FORMAT}"]

# Healthcheck wired here so registries / orchestrators see it.
HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
    CMD wget -q -O- http://localhost:9222/json/version > /dev/null || exit 1
